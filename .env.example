# ============================================
# Murder Mystery - Environment Variables
# ============================================
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to version control.

# Supabase (client-accessible)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Supabase service role (server-only, used by Route Handlers)
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# AI (Google Gemini API)
AI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-2.5-flash-lite

# Admin
ADMIN_PASSCODE=your-admin-passcode

# Default event code (used on home/leaderboard/admin pages)
NEXT_PUBLIC_DEFAULT_EVENT_CODE=ATRIA

# Database connection string (for scripts & migrations)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres